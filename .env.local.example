# ===== 툴사장 환경 변수 템플릿 =====
# 이 파일을 복사하여 .env.local 로 저장한 뒤 값을 채워 넣으세요.
# .env.local 은 .gitignore 에 포함되어 있으므로 커밋되지 않습니다.

# ---- 사이트 기본 정보 ----
NEXT_PUBLIC_SITE_URL=https://toolsajang.com
NEXT_PUBLIC_SITE_NAME=툴사장

# ---- Google Analytics 4 ----
# Google Analytics 콘솔에서 발급 (G-XXXXXXXXXX 형태)
NEXT_PUBLIC_GA_ID=

# ---- Google AdSense ----
# AdSense 승인 후 발급 (ca-pub-XXXXXXXXXXXXXXXX 형태)
NEXT_PUBLIC_ADSENSE_ID=

# ---- Google Search Console 소유 확인 ----
# Search Console > 속성 추가 > HTML 태그 방식 > content 값만 입력
# 예: abc123xyz (따옴표 없이 값만)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- 네이버 서치어드바이저 소유 확인 ----
# 서치어드바이저 > 사이트 등록 > HTML 메타태그 방식 > content 값만 입력
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# ---- OG 이미지 fallback (선택) ----
# 동적 OG 이미지(next/og)가 우선이므로 보통 불필요
# NEXT_PUBLIC_OG_IMAGE_URL=https://toolsajang.com/images/og-default.png

# ---- AI 툴 API 키 (메뉴명·가게명 아이디어) ----
# Gemini를 우선 사용, 없으면 Groq → OpenRouter 순으로 폴백
# Google AI Studio에서 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API (선택, 폴백용): https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter API (선택, 폴백용): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- AI 비용 한도 (선택, 기본값 사용 가능) ----
# 주간 최대 비용 (USD, 기본: 5)
AI_WEEKLY_LIMIT_USD=5
# 월간 최대 비용 (USD, 기본: 15)
AI_MONTHLY_LIMIT_USD=15
